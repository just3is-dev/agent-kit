#!/usr/bin/env bash
# agent-kit/swift-ios: статические проверки (линт + типы). Тулчейн Xcode 16+:
# линт и формат — swift format из его состава, без внешних установок.
set -eo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
source "$script_dir/lib.sh"
cd "$script_dir/.."

# Пакет собирается, только когда его директории уже на месте: пока агент
# создаёт файлы по одному, Package.swift без Sources/ или без Tests/ при
# объявленном testTarget — не ошибка кода, а промежуточное состояние.
buildable() {
  [ -d "$1/Sources" ] || return 1
  ! grep -q 'testTarget' "$1/Package.swift" || [ -d "$1/Tests" ]
}

# swift build шумит даже с -q; вывод показывается только при ошибке.
build_quiet() {
  out=$(swift build --package-path "$1" 2>&1) || { printf '%s\n' "$out" >&2; return 1; }
}

# Ближайший родительский SPM-пакет файла (пусто — файл вне пакетов).
package_of() {
  d=$(dirname "$1")
  while :; do
    if [ -f "$d/Package.swift" ]; then
      printf '%s\n' "$d"
      return
    fi
    if [ "$d" = "/" ] || [ "$d" = "." ]; then
      return
    fi
    d=$(dirname "$d")
  done
}

if [ $# -gt 0 ]; then
  targets=()
  for f in "$@"; do
    case "$f" in
      *.swift) [ -f "$f" ] && targets+=("$f") ;;
    esac
  done
  [ ${#targets[@]} -gt 0 ] || exit 0
  # lint без --strict возвращает 0 даже при найденных нарушениях
  swift format lint --strict "${targets[@]}"
  # Типы: инкрементальная сборка пакетов, которым принадлежат переданные
  # файлы. Файлы вне пакетов (таргеты приложения) компилируются только в
  # scripts/test.
  pkgs=$(for f in "${targets[@]}"; do package_of "$f"; done | sort -u)
  while IFS= read -r d; do
    [ -n "$d" ] && buildable "$d" || continue
    build_quiet "$d"
  done < <(printf '%s\n' "$pkgs")
else
  files=()
  while IFS= read -r f; do files+=("$f"); done < <(find_clean '*.swift')
  [ ${#files[@]} -eq 0 ] || swift format lint --strict "${files[@]}"

  # Типы: сборка всех SPM-пакетов (секунды). Компиляция таргетов приложения —
  # в scripts/test: ей нужны xcodegen/симулятор и минуты, а полный check
  # должен оставаться быстрым гейтом.
  while IFS= read -r pkg; do
    buildable "$(dirname "$pkg")" || continue
    build_quiet "$(dirname "$pkg")"
  done < <(find_clean 'Package.swift')

fi
