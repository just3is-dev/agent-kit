#!/usr/bin/env bash
# agent-kit/monorepo: тесты всех пакетов. Падение любого — провал.
set -eo pipefail
cd "$(dirname "$0")/.."
root="$PWD"

packages=$(find . -mindepth 3 -maxdepth 5 \( -name node_modules -o -name .git -o -name .venv \) -prune -o -type f -path '*/scripts/test' -print | sed 's|/scripts/test$||; s|^\./||' | sort)

for p in $packages; do
  echo "── test: $p"
  (cd "$root/$p" && ./scripts/test)
done
