#!/usr/bin/env bash
# agent-kit/monorepo: корневой диспетчер проверок.
# Пакет = поддиректория со своим scripts/check. С аргументами гоняет только
# пакеты, которым принадлежат файлы; без аргументов — все.
set -eo pipefail
cd "$(dirname "$0")/.."
root="$PWD"

packages=$(find . -mindepth 3 -maxdepth 5 \( -name node_modules -o -name .git -o -name .venv \) -prune -o -type f -path '*/scripts/check' -print | sed 's|/scripts/check$||; s|^\./||' | sort)

run_pkg() {
  pkg="$1"; shift
  echo "── check: $pkg"
  (cd "$root/$pkg" && ./scripts/check "$@")
}

if [ $# -eq 0 ]; then
  for p in $packages; do run_pkg "$p"; done
  exit 0
fi

for p in $packages; do
  pkg_files=()
  for f in "$@"; do
    abs="$f"
    case "$abs" in /*) ;; *) abs="$root/$f" ;; esac
    case "$abs" in "$root/$p"/*) pkg_files+=("$abs") ;; esac
  done
  if [ ${#pkg_files[@]} -gt 0 ]; then
    run_pkg "$p" "${pkg_files[@]}"
  fi
done
