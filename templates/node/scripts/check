#!/usr/bin/env bash
# agent-kit/node: статические проверки (типы + линт).
# С аргументами линтит только переданные файлы; типы всегда по проекту.
# Линтер берётся из package.json: oxlint или eslint.
set -eo pipefail
cd "$(dirname "$0")/.."

npx tsc --noEmit --pretty false

LINT_TOOL=$(node -e '
let pkg = {};
try { pkg = require("./package.json"); } catch (e) {}
const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
if (deps.oxlint) process.stdout.write("oxlint");
else if (deps.eslint) process.stdout.write("eslint");
')
if [ -z "$LINT_TOOL" ]; then
  echo "scripts/check: в package.json нет ни oxlint, ни eslint" >&2
  exit 1
fi

if [ $# -gt 0 ]; then
  targets=()
  for f in "$@"; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) targets+=("$f") ;;
    esac
  done
  [ ${#targets[@]} -gt 0 ] || exit 0
  npx "$LINT_TOOL" --max-warnings 0 --no-error-on-unmatched-pattern "${targets[@]}"
elif [ "$LINT_TOOL" = "oxlint" ]; then
  npx oxlint --max-warnings 0 --ignore-pattern node_modules .
else
  npx eslint --max-warnings 0 .
fi
