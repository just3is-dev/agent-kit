#!/usr/bin/env bash
# agent-kit/node: все тесты проекта.
# --passWithNoTests: свежий проект без тестов не блокирует Stop-хук.
# Тест-раннер берётся из package.json (своего или родительского): vitest или jest.
set -eo pipefail
cd "$(dirname "$0")/.."

TEST_RUNNER=$(node -e '
// По родительским package.json тоже: в монорепо dev-зависимости живут в корне.
const fs = require("fs"), path = require("path");
let dir = process.cwd(), tool = "";
while (!tool) {
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
    const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
    if (deps.vitest) tool = "vitest"; else if (deps.jest) tool = "jest";
  } catch (e) {}
  const parent = path.dirname(dir);
  if (parent === dir) break;
  dir = parent;
}
process.stdout.write(tool);
')
if [ -z "$TEST_RUNNER" ]; then
  echo "scripts/test: в package.json (и родительских) нет ни vitest, ни jest" >&2
  exit 1
fi

if [ "$TEST_RUNNER" = "vitest" ]; then
  npx vitest run --passWithNoTests
else
  npx jest --passWithNoTests
fi
