#!/usr/bin/env bash
# agent-kit/astro: автоформат. Файлы .astro форматирует prettier с
# prettier-plugin-astro; без плагина они пропускаются (--ignore-unknown).
# Инструменты — из package.json, своего или родительского (монорепо).
set -eo pipefail
cd "$(dirname "$0")/.."

tools=$(node -e '
const fs = require("fs"), path = require("path");
let dir = process.cwd(), lint = "", prettier = "";
for (;;) {
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
    const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
    if (!lint && deps.oxlint) lint = "oxlint"; else if (!lint && deps.eslint) lint = "eslint";
    if (deps.prettier) prettier = "prettier";
  } catch (e) {}
  if (lint && prettier) break;
  const parent = path.dirname(dir);
  if (parent === dir) break;
  dir = parent;
}
process.stdout.write(lint + " " + prettier);
')
LINT_TOOL=${tools% *}
PRETTIER=${tools#* }

# Без prettier в зависимостях форматирование пропускается: npx не должен
# ставить его из сети, особенно в чужой проект (/init --local).
fmt() { [ -n "$PRETTIER" ] || return 0; npx prettier --write --log-level warn --ignore-unknown "$@"; }

if [ $# -gt 0 ]; then
  fmt "$@"
  [ -n "$LINT_TOOL" ] && npx "$LINT_TOOL" --fix --no-error-on-unmatched-pattern "$@" >/dev/null 2>&1 || true
else
  fmt .
  [ -n "$LINT_TOOL" ] && npx "$LINT_TOOL" --fix . >/dev/null 2>&1 || true
fi
