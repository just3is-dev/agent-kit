#!/usr/bin/env bash
# agent-kit/astro: статические проверки. `astro check` — типы в .astro/.ts
# (нужны @astrojs/check и typescript в devDependencies); линтер — если в
# package.json есть oxlint или eslint, иначе только astro check.
set -eo pipefail
cd "$(dirname "$0")/.."

npx astro check --minimumSeverity error

LINT_TOOL=$(node -e '
let pkg = {};
try { pkg = require("./package.json"); } catch (e) {}
const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
if (deps.oxlint) process.stdout.write("oxlint");
else if (deps.eslint) process.stdout.write("eslint");
')
[ -n "$LINT_TOOL" ] || exit 0

if [ $# -gt 0 ]; then
  targets=()
  for f in "$@"; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.astro) targets+=("$f") ;;
    esac
  done
  [ ${#targets[@]} -gt 0 ] || exit 0
  npx "$LINT_TOOL" --max-warnings 0 --no-error-on-unmatched-pattern "${targets[@]}"
elif [ "$LINT_TOOL" = "oxlint" ]; then
  npx oxlint --max-warnings 0 --ignore-pattern node_modules --ignore-pattern dist .
else
  npx eslint --max-warnings 0 .
fi
