#!/usr/bin/env bash
# Контракт самого кита: синтаксис shell-скриптов и валидность манифеста.
set -eo pipefail
cd "$(dirname "$0")/.."

if [ $# -gt 0 ]; then
  for f in "$@"; do
    case "$f" in
      *.sh|scripts/check|scripts/test|scripts/fix) bash -n "$f" ;;
      *.json) python3 -m json.tool "$f" >/dev/null ;;
    esac
  done
  exit 0
fi

for f in hooks/scripts/*.sh hooks/scripts/lib/*.sh scripts/* tests/*.sh; do
  bash -n "$f"
done
for f in .claude-plugin/*.json hooks/hooks.json; do
  python3 -m json.tool "$f" >/dev/null
done
